# ── Telegram ──────────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your channel username (e.g. @YourChannel) or numeric chat ID (e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel_here

# ── Finnhub ───────────────────────────────────────────────────────────────────
# Free API key from https://finnhub.io — takes 2 minutes to sign up
FINNHUB_API_KEY=your_finnhub_key_here
